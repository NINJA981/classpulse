# ClassPulse internal router for Coolify. Coolify's Traefik terminates TLS for the public domain and forwards
# plain HTTP here; this keeps the same single-origin routing as infra/Caddyfile (web + /api + /socket.io).
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}

	# Lecture uploads can be large; device chunks are ~2 MB. The matchers must not overlap: Caddy applies
	# every matching request_body in turn, so a catch-all limit would also cap lecture uploads.
	@lectureUpload path /api/lessons/*/audio
	request_body @lectureUpload {
		max_size 400MB
	}
	@otherBodies not path /api/lessons/*/audio
	request_body @otherBodies {
		max_size 25MB
	}

	# Platform console (super admin) lives only on PLATFORM_HOST (e.g. ops.example.org): invisible on school
	# addresses, and the platform address serves nothing but the console. Named-matcher `handle` blocks keep
	# the order written here, so these run before the general routes below.
	@platformOnSchoolHost {
		not host {$PLATFORM_HOST:platform.invalid}
		path /platform /platform/* /api/platform /api/platform/*
	}
	handle @platformOnSchoolHost {
		respond "Not found" 404
	}

	@platformRoot {
		host {$PLATFORM_HOST:platform.invalid}
		path /
	}
	handle @platformRoot {
		redir * /platform 302
	}

	@platformHostOther {
		host {$PLATFORM_HOST:platform.invalid}
		not path /platform /platform/* /api/platform/* /api/status /_next/* /favicon.ico /icon* /apple-icon* /icons/* /manifest.webmanifest /sw.js /offline /robots.txt
	}
	handle @platformHostOther {
		respond "Not found" 404
	}

	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy api:5000 {
			# Device command long-polls hold for up to 25 s. Pooled connections are dropped well before the
			# upstream's own keep-alive timeout (75 s) so a request never lands on a socket being closed.
			transport http {
				read_timeout 120s
				keepalive 30s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				keepalive 30s
			}
		}
	}

	log {
		output stdout
		format json
	}
}
