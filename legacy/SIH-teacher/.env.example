# ==============================================================================
# SIH-teacher: Environment Configuration (.env.example)
# ==============================================================================
# Port: 3000

# ------------------------------------------------------------------------------
# 1. API BACKEND ENDPOINT
# ------------------------------------------------------------------------------
# Option A — Localhost Development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Option B — Tailscale / Multi-Device Testing:
# NEXT_PUBLIC_API_BASE_URL=http://100.64.188.15:5000/api

# ------------------------------------------------------------------------------
# 2. DATA SOURCE MODE
# ------------------------------------------------------------------------------
# false = Connects to live MongoDB backend & embedded AI pipeline (POST /api/lessons/:id/generate)
# true  = Falls back to browser localStorage mocks
NEXT_PUBLIC_USE_MOCK=false
