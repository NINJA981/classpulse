# ================================================
# Development Stage (Hot-Reloading with Next.js)
# ================================================
FROM node:20-alpine

WORKDIR /app

# Copy package manifests & install all dependencies
COPY package*.json ./
RUN npm install

# Copy application source files
COPY . .

# Expose Next.js dev server ports
EXPOSE 5172 5173 5174 5175

# Run Next.js dev server
CMD ["npm", "run", "dev"]
