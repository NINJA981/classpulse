{
  "name": "classiq",
  "private": true,
  "description": "ClassIQ — AI classroom platform (API, unified web app, Raspberry Pi classroom agent)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n shared,api,worker,web -c gray,blue,magenta,green \"npm run dev -w @classiq/shared\" \"npm run dev -w @classiq/api\" \"npm run dev:worker -w @classiq/api\" \"npm run dev -w @classiq/web\"",
    "dev:infra": "docker compose -f infra/docker-compose.dev.yml up -d",
    "build": "npm run build -w @classiq/shared && npm run build -w @classiq/api && npm run build -w @classiq/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:agent": "python -m pytest apps/classroom-agent/tests -q",
    "test:e2e": "npm run test:e2e -w @classiq/web",
    "db:generate": "npm run db:generate -w @classiq/api",
    "db:migrate": "npm run db:migrate -w @classiq/api",
    "db:seed": "npm run db:seed -w @classiq/api",
    "create-admin": "npm run create-admin -w @classiq/api --",
    "create-superadmin": "npm run create-superadmin -w @classiq/api --",
    "create-superadmin:prod": "npm run create-superadmin:prod -w @classiq/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
