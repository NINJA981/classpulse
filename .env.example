# ==============================================================================
# SIH-backend: Environment Configuration (.env.example)
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# MONGODB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option 1: Embedded In-Memory MongoDB (Zero-Setup Dev Mode)
#   If no MongoDB service is running at 127.0.0.1:27017, the server will
#   automatically start an embedded in-memory MongoDB instance and seed initial data.
MONGODB_URI=mongodb://127.0.0.1:27017/classpulse

# Option 2: MongoDB Atlas (Cloud Cluster)
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/classpulse?retryWrites=true&w=majority

# Option 3: Local MongoDB Community Service
# MONGODB_URI=mongodb://localhost:27017/classpulse

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=classpulse_super_secret_jwt_key_2026

# Allowed CORS Origins (Comma-separated)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5171,http://localhost:5174,http://100.64.188.15:3000,http://100.64.188.15:3001,http://100.64.188.15:5171,http://100.64.188.15:5174

# ------------------------------------------------------------------------------
# EMBEDDED LECTURE PROCESSING PIPELINE (In-Process Default)
# ------------------------------------------------------------------------------
# PIPELINE_MODE: "embedded" (default, zero extra services) or "remote" (port 4000 sidecar)
PIPELINE_MODE=embedded

# Optional Cloud AI Services for Production:
# 1. Sarvam AI Batch Transcription (Indian English + regional speech)
# SARVAM_API_KEY=your_sarvam_api_key

# 2. LLM Quiz & Summary Generation (OpenAI / Gemini / Ollama)
# OPENAI_API_KEY=your_openai_api_key
# LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
# LLM_MODEL=gpt-4o-mini

# Optional: Only needed if PIPELINE_MODE=remote
# PIPELINE_URL=http://localhost:4000
# PIPELINE_API_KEY=
