# Production configuration for infra/docker-compose.prod.yml.
# Copy to infra/.env (never commit it) and fill in every value.

# Public hostname (DNS A record → this VPS). Caddy obtains TLS certificates automatically.
DOMAIN=app.example.org
ACME_EMAIL=ops@example.org
# The super admin console's own hostname (DNS A record → this VPS). /platform is 404 on DOMAIN.
PLATFORM_HOST=ops.example.org
# Encrypts authenticator-app secrets of super admins. Generate with:  openssl rand -base64 32
PLATFORM_ENCRYPTION_KEY=

# Generate each with:  openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=
# Goes into a URL and a redis.conf line, so hex only:  openssl rand -hex 32
REDIS_PASSWORD=

# Object storage (Garage, the `storage` service). All four are needed before the first deploy with Garage.
# Node-to-node RPC secret, exactly 32 bytes hex:  openssl rand -hex 32
GARAGE_RPC_SECRET=
# Admin API token (only storage-init uses it):  openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
# The application's S3 key. Garage's format: GK + 24 hex, and a 64-hex secret.
#   echo "GK$(openssl rand -hex 12)"      and      openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Capacity this node advertises (set once, when the layout is created). Bucket name.
GARAGE_CAPACITY=50G
S3_BUCKET=classpulse
# local = files in the storage_data volume; s3 = files in Garage. Change to s3 only after migrating the files
# (docs/agents/deployment.md → "Object storage (Garage)").
STORAGE_DRIVER=local

# AI providers (lesson transcription + quiz generation). Generation fails clearly if unset.
SARVAM_API_KEY=
OPENAI_API_KEY=

# Raw lecture audio is deleted this many days after upload/recording.
AUDIO_RETENTION_DAYS=30
# Concurrent lesson-generation jobs (2 suits a 4 GB / 2 vCPU VPS).
GENERATION_CONCURRENCY=2

# Outgoing email (optional): set-password invitations, password resets, assignment reminders.
# Gmail/Workspace: enable 2-Step Verification on the sending account, then create an App password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Inbox for "Book a demo" requests from /about. Empty = the address in MAIL_FROM.
DEMO_REQUEST_TO=

# Web Push (phone/desktop notifications when an AI job finishes). Optional: push is off while these are
# empty (in-app notifications always work). Generate a pair with: npx web-push generate-vapid-keys
# Never commit real keys; keep the same pair for good (changing it invalidates every device subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@benxsolutions.in
LOG_LEVEL=info

# Backups (infra/backup.sh)
BACKUP_DIR=/var/backups/classpulse
# Recipient public key for `age` encryption (https://age-encryption.org). Required.
BACKUP_AGE_RECIPIENT=
# Optional off-site copy: s3://bucket/prefix (aws cli) or an rclone remote such as oci:bucket/prefix.
BACKUP_S3_URI=
# aws cli + OCI Object Storage: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com, with
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from an OCI Customer Secret Key and AWS_DEFAULT_REGION=<region>.
BACKUP_S3_ENDPOINT=
# Delete off-site copies older than N days (empty/0 = never; prefer a bucket lifecycle rule with a
# write-only key, in which case leave this empty).
BACKUP_S3_KEEP_DAYS=
# Where backup.sh/restore.sh read and write stored files: local | s3. Empty = follow the api's STORAGE_DRIVER.
# In s3 mode they use S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from this file (never from the containers).
BACKUP_STORAGE_MODE=
