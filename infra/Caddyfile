# ClassPulse edge proxy. One origin serves the web app, the API and Socket.IO.
# DOMAIN=app.example.org → automatic Let's Encrypt certificates.
# DOMAIN=localhost       → Caddy's internal CA (local production smoke tests).
# PLATFORM_HOST=ops.example.org → the super admin console's own address (it is invisible on DOMAIN).
{
	email {$ACME_EMAIL:admin@localhost}
}

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}

	log {
		output stdout
		format json
	}
}

(upstreams) {
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy api:5000 {
			# Device command long-polls hold for up to 25 s. Pooled connections are dropped well before the
			# upstream's own keep-alive timeout (75 s) so a request never lands on a socket being closed.
			transport http {
				read_timeout 120s
				keepalive 30s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				keepalive 30s
			}
		}
	}
}

{$DOMAIN:localhost} {
	import common

	# Lecture uploads can be large; device chunks are ~2 MB. The matchers must not overlap: Caddy applies
	# every matching request_body in turn, so a catch-all limit would also cap lecture uploads.
	@lectureUpload path /api/lessons/*/audio
	request_body @lectureUpload {
		max_size 400MB
	}
	@otherBodies not path /api/lessons/*/audio
	request_body @otherBodies {
		max_size 25MB
	}

	# The platform console is served only on PLATFORM_HOST.
	@platform path /platform /platform/* /api/platform /api/platform/*
	handle @platform {
		respond "Not found" 404
	}

	import upstreams
}

{$PLATFORM_HOST:platform.localhost} {
	import common

	request_body {
		max_size 5MB
	}

	@root path /
	handle @root {
		redir * /platform 302
	}

	@notConsole not path /platform /platform/* /api/platform/* /api/status /_next/* /favicon.ico /icon* /apple-icon* /icons/* /manifest.webmanifest /sw.js /offline /robots.txt
	handle @notConsole {
		respond "Not found" 404
	}

	import upstreams
}
