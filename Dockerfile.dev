# ================================================
# Development Stage (Hot-Reloading with Vite)
# ================================================
FROM node:20-alpine

WORKDIR /app

# Copy package manifests & install all dependencies
COPY package*.json ./
RUN npm install

# Copy application source files
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server with host flag for Docker networking
CMD ["npm", "run", "dev", "--", "--host"]
