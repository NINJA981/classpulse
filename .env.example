# ==============================================================================
# SIH-student: Environment Configuration (.env.example)
# ==============================================================================
# Port: 3001

# ------------------------------------------------------------------------------
# 1. API BACKEND ENDPOINT
# ------------------------------------------------------------------------------
# Connects to SIH-backend to fetch pipeline-generated quizzes (/api/student/quizzes),
# submit answers for instant grading, and load classroom diagnostics.
#
# Option A — Localhost Development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Option B — Tailscale / Multi-Device Testing:
# NEXT_PUBLIC_API_BASE_URL=http://100.64.188.15:5000/api

# ------------------------------------------------------------------------------
# 2. OPTIONAL AUXILIARY SUPABASE (Only if using standalone Supabase auth)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
