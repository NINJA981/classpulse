# ClassPulse edge proxy. One origin serves the web app, the API and Socket.IO.
# DOMAIN=app.example.org → automatic Let's Encrypt certificates.
# DOMAIN=localhost       → Caddy's internal CA (local production smoke tests).
{
	email {$ACME_EMAIL:admin@localhost}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}

	# Lecture uploads can be large; device chunks are ~2 MB. The matchers must not overlap: Caddy applies
	# every matching request_body in turn, so a catch-all limit would also cap lecture uploads.
	@lectureUpload path /api/lessons/*/audio
	request_body @lectureUpload {
		max_size 400MB
	}
	@otherBodies not path /api/lessons/*/audio
	request_body @otherBodies {
		max_size 25MB
	}

	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy api:5000 {
			# Device command long-polls hold for up to 25 s. Pooled connections are dropped well before the
			# upstream's own keep-alive timeout (75 s) so a request never lands on a socket being closed.
			transport http {
				read_timeout 120s
				keepalive 30s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				keepalive 30s
			}
		}
	}

	log {
		output stdout
		format json
	}
}
