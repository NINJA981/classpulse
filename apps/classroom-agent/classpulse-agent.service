[Unit]
Description=ClassPulse classroom recording agent
Documentation=file:///opt/classpulse-agent/README.md
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=classpulse
Group=classpulse
SupplementaryGroups=audio
# Everything the agent writes (device key, audio chunks, manifests) is owner-only.
UMask=0077
WorkingDirectory=/opt/classpulse-agent
Environment=PYTHONUNBUFFERED=1
Environment=CLASSPULSE_CONFIG=/etc/classpulse/agent.json
ExecStart=/usr/bin/python3 /opt/classpulse-agent/agent.py
Restart=always
RestartSec=5
# Give the recorder time to flush its partial chunk on stop.
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

# Hardening: read-only system, writable state dir only, outbound network only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/classpulse
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# /dev/snd must stay reachable for arecord (no PrivateDevices).

[Install]
WantedBy=multi-user.target
