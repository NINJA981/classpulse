# ClassIQ edge proxy. One origin serves the web app, the API and Socket.IO.
# DOMAIN=app.example.org → automatic Let's Encrypt certificates.
# DOMAIN=localhost       → Caddy's internal CA (local production smoke tests).
# PLATFORM_HOST=ops.example.org → the super admin console's own address (it is invisible on DOMAIN).
#
# This Caddy IS the edge: clients connect to it directly. It deliberately does NOT set trusted_proxies, so
# reverse_proxy replaces any client-sent X-Forwarded-For with the real peer address and a client cannot
# forge its IP. The API trusts exactly one hop (TRUST_PROXY_HOPS=1). Compare infra/Caddyfile.coolify,
# which sits behind Coolify's Traefik and must trust it.
{
	email {$ACME_EMAIL:admin@localhost}
}

(common) {
	encode zstd gzip

	header {
		# HSTS preload is NOT set: it commits every subdomain of the registered domain to HTTPS for good.
		# Recommended once every subdomain is HTTPS-only: add "; preload" and submit at hstspreload.org.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
	}

	# Security headers for the web app's pages. /api and /socket.io are excluded: the API sets its own
	# (stricter) helmet CSP and X-Frame-Options, and this must not override them.
	# - script-src needs 'unsafe-inline': Next.js emits inline bootstrap scripts without nonces. A
	#   nonce-based script-src set from apps/web/proxy.ts is the follow-up that lets this drop it.
	# - connect-src: 'self' covers same-host wss: in current browsers; wss://<this host> is for older Safari.
	# - frame-src: the simulation allow-list (apps/api/src/modules/resources/simulations.ts). Keep in sync.
	@pages not path /api/* /socket.io/*
	header @pages {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' wss://{http.request.host}; worker-src 'self'; manifest-src 'self'; frame-src https://phet.colorado.edu https://www.geogebra.org https://geogebra.org https://www.desmos.com https://ophysics.com https://www.olabs.edu.in; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
	}

	# JSON access log without secrets. Cookie, Set-Cookie and Authorization are already redacted by Caddy.
	# Removed here: the long-lived device key, the exam device token, set-password tokens in the query
	# string (?token=) and in /api/auth/password-token/<token>.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Device-Key delete
				request>headers>X-Exam-Token delete
				request>uri multi_regexp {
					regexp "\?token=[^&#]*" "?token=REDACTED"
					regexp "&token=[^&#]*" "&token=REDACTED"
					regexp "/api/auth/password-token/[^/?#]+" "/api/auth/password-token/REDACTED"
				}
			}
		}
	}
}

(upstreams) {
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy api:5000 {
			# Device command long-polls hold for up to 25 s. Pooled connections are dropped well before the
			# upstream's own keep-alive timeout (75 s) so a request never lands on a socket being closed.
			transport http {
				read_timeout 120s
				keepalive 30s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				keepalive 30s
			}
		}
	}
}

{$DOMAIN:localhost} {
	import common

	# Lecture uploads can be large; device chunks are ~2 MB. The matchers must not overlap: Caddy applies
	# every matching request_body in turn, so a catch-all limit would also cap lecture uploads.
	@lectureUpload path /api/lessons/*/audio
	request_body @lectureUpload {
		max_size 400MB
	}
	@otherBodies not path /api/lessons/*/audio
	request_body @otherBodies {
		max_size 25MB
	}

	# The platform console is served only on PLATFORM_HOST.
	@platform path /platform /platform/* /api/platform /api/platform/*
	handle @platform {
		respond "Not found" 404
	}

	import upstreams
}

{$PLATFORM_HOST:platform.localhost} {
	import common

	request_body {
		max_size 5MB
	}

	@root path /
	handle @root {
		redir * /platform 302
	}

	@notConsole not path /platform /platform/* /api/platform/* /api/status /_next/* /favicon.ico /icon* /apple-icon* /icons/* /manifest.webmanifest /sw.js /offline /robots.txt /privacy /terms
	handle @notConsole {
		respond "Not found" 404
	}

	import upstreams
}
