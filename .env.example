# ==============================================================================
# SIH-admin: Environment Configuration (.env.example)
# ==============================================================================
# Ports: 5174 (Admin Dashboard) / 5171 (Admin Login Portal)

# ------------------------------------------------------------------------------
# 1. API BACKEND ENDPOINT
# ------------------------------------------------------------------------------
# Connects to SIH-backend for system health checks (/api/health) and telemetry.
#
# Option A — Localhost Development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Option B — Tailscale / Multi-Device Testing:
# NEXT_PUBLIC_API_BASE_URL=http://100.64.188.15:5000/api

# ------------------------------------------------------------------------------
# 2. ROLE & PORT ROUTING
# ------------------------------------------------------------------------------
# App Role: 'admin' for main dashboard (port 5174) or 'admin-login' for login portal (port 5171)
NEXT_PUBLIC_APP_ROLE=admin

# Server port for Next.js dev server
PORT=5174

# Target admin port used for redirects from login portal
NEXT_PUBLIC_ADMIN_PORT=5174
