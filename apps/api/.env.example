# ClassPulse API — local development. Production values live in infra/.env (see docs/agents/deployment.md).
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

DATABASE_URL=postgres://classpulse:classpulse@localhost:5432/classpulse
# Leave empty to run generation jobs in-process (no Redis needed).
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-local-secret-0123456789abcdef
SESSION_TTL_HOURS=12
PUBLIC_ORIGIN=http://localhost:3000

STORAGE_DIR=./storage
# Stored files go to STORAGE_DIR (`local`, the default) or to an S3 bucket (`s3`). For S3 against the dev
# Garage (npm run dev:infra starts it on 127.0.0.1:3900), uncomment these. DEV-ONLY credentials, matching
# infra/docker-compose.dev.yml; production generates its own (docs/agents/deployment.md).
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://127.0.0.1:3900
# S3_BUCKET=classpulse
# S3_REGION=garage
# S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
# S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  # gitleaks:allow (dev-only fake value)
# Temporary files (uploads in progress, transcodes, S3 downloads); always local. Default: STORAGE_DIR/tmp
# TMP_DIR=./storage/tmp
AUDIO_RETENTION_DAYS=30
# Lesson transcripts are deleted this many days after the lesson was created (quizzes stay)
TRANSCRIPT_RETENTION_DAYS=365
MAX_AUDIO_UPLOAD_MB=300
# Longest lesson recording, in seconds (4 h). Longer uploads are refused.
MAX_LESSON_AUDIO_SEC=14400
# Monthly AI transcription minutes for schools without their own limit (0 = no cap).
DEFAULT_AI_AUDIO_MINUTES_PER_MONTH=3000

# AI providers — required for real lesson generation.
SARVAM_API_KEY=
OPENAI_API_KEY=

# Development only: generate clearly-labelled demo content when providers are not configured.
PIPELINE_DEMO_FALLBACK=false
GENERATION_CONCURRENCY=2

# Outgoing email (optional): set-password invitations, password resets, assignment reminders.
# Gmail/Workspace: enable 2-Step Verification on the sending account, then create an App password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Inbox for "Book a demo" requests from /about (POST /api/public/demo-requests). Empty = the address in
# MAIL_FROM. Requests always go to this fixed address, never to the visitor's own email.
DEMO_REQUEST_TO=

# Web Push (phone/desktop notifications when an AI job finishes). Optional: push is off while these are
# empty (in-app notifications always work). Generate a pair with: npx web-push generate-vapid-keys
# Never commit real keys; keep the same pair for good (changing it invalidates every device subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@benxsolutions.in

# Platform console (super admin). The key encrypts authenticator secrets: openssl rand -base64 32
# (required in production). PLATFORM_ORIGIN is the console's own address, e.g. https://ops.example.org.
PLATFORM_ORIGIN=
PLATFORM_ENCRYPTION_KEY=
# Deployments page (optional): Coolify API base (http://host:8000/api/v1), a read + deploy token, the app uuid.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_APP_UUID=
# Where host backups are mounted (read-only) for the backup age check.
BACKUP_DIR=/backups
DEVICE_OFFLINE_AFTER_SEC=90
# Login attempts per IP+account per 15 min (raise locally for repeated e2e runs).
LOGIN_RATE_LIMIT=10
# Sign-in attempts per IP per 15 min across all accounts (schools behind one NAT share an IP).
AUTH_IP_RATE_LIMIT=1500
# "Book a demo" requests per IP per hour (raise locally for repeated e2e runs).
DEMO_REQUEST_RATE_LIMIT=5
