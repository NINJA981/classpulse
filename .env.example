# ==========================================
# SIH-backend: Environment Configuration
# ==========================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Connection String (Atlas URI or Local MongoDB instance)
# Leave default to connect to local MongoDB. 
# If local MongoDB is not running, the server automatically starts an in-memory MongoDB fallback in dev.
MONGODB_URI=mongodb://127.0.0.1:27017/classpulse

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=classpulse_super_secret_jwt_key_2026

# Environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS Origins (Comma-separated URLs)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5171,http://localhost:5174

# ==========================================
# Lecture Pipeline Sidecar (see pipeline repo README)
# ==========================================
# Base URL of the pipeline API (run `npm run dev` in the pipeline repo)
PIPELINE_URL=http://localhost:4000
# The pipeline's EMBED_API_KEY — server-side secret, never exposed to browsers.
# Sarvam/OpenAI keys live in the PIPELINE's .env, not here.
PIPELINE_API_KEY=

